  - {fileID: 11400000, guid: 17d52de407e624548a2cbdedf936976a, type: 2}
  notebookLeadText: "\u0418\u0432\u0430\u043D\u043E\u0432\u0430 \u0415.\u0410. \u0431\u044B\u043B\u0430
    \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0435 \u043D\u0430\u043A\u0430\u043D\u0443\u043D\u0435
    \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0441
    19:00 \u0434\u043E 22:00. \u0412 \u0434\u0435\u043D\u044C \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430
    \u043E\u043D\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0430 \u0441
    \u0434\u0432\u0443\u043C\u044F \u0441\u0442\u0430\u043A\u0430\u043D\u0430\u043C\u0438
    \u043A\u043E\u0444\u0435 \u0438 \u043F\u0430\u043A\u0435\u0442\u043E\u043C \u0438\u0437
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \xAB\u041A\u0440\u0430\u0441\u043D\u043E-\u0431\u0435\u043B\u043E\u0435\xBB.
    \u041F\u043E\u0441\u043B\u0435 \u0435\u0451 \u0443\u0445\u043E\u0434\u0430 (\u0432
    18:00) \u0432 \u043A\u0432\u0430\u0440\u0442\u0438\u0440\u0443 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0421\u043E\u043A\u043E\u043B\u043E\u0432."
  motiveOptions:
  - text: "\u041A\u0440\u0430\u0436\u0430 \u0434\u0435\u043D\u0435\u0433"
    isCorrect: 1
  - text: "\u0421\u043E\u043A\u0440\u044B\u0442\u0438\u0435 \u0444\u0430\u043A\u0442\u0430
      \u0443\u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u044F \u043D\u0430\u0440\u043A\u043E\u0442\u0438\u043A\u043E\u0432"
    isCorrect: 0
  - text: "\u0420\u0435\u0432\u043D\u043E\u0441\u0442\u044C"
    isCorrect: 0
  - text: "\u0418\u0437\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043E\u0442
      \u0441\u0443\u043F\u0440\u0443\u0433\u0438"
    isCorrect: 0
  - text: "\u041D\u0435\u0443\u043F\u043B\u0430\u0442\u0430 \u0434\u043E\u043B\u0433\u0430"
    isCorrect: 0
  causeOfDeathOptions:
  - text: "\u041F\u0435\u0440\u0435\u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0430
      \u043A\u043E\u043A\u0430\u0438\u043D\u043E\u043C"
    isCorrect: 0
  - text: "\u041D\u0430\u0441\u0438\u043B\u044C\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u0441\u043C\u0435\u0440\u0442\u044C"
    isCorrect: 0
  - text: "\u041F\u0435\u0440\u0435\u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0430
      \u043A\u043B\u043E\u0444\u0435\u043B\u0438\u043D\u043E\u043C"
    isCorrect: 1
  - text: "\u041E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u043C
      \u044F\u0434\u043E\u043C"
    isCorrect: 0
  - text: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u0441\u0435\u0440\u0434\u0446\u0430"
    isCorrect: 0
  suspectOptions:
  - text: "\u0418\u0432\u0430\u043D\u043E\u0432\u0430 \u0415. \u0410."
    isCorrect: 1
  - text: "\u0421\u043E\u043A\u043E\u043B\u043E\u0432 \u0412. \u041D."
    isCorrect: 0
  - text: "\u041D\u0435\u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u043E\u0435
      \u043B\u0438\u0446\u043E"
    isCorrect: 0
  - text: "\u0421\u043E\u043A\u043E\u043B\u043E\u0432\u0430 \u0418. \u0410."
    isCorrect: 0
